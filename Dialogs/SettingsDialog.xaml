<Window
    x:Class="GreenLuma_Manager.Dialogs.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Settings"
    Width="800"
    Height="580"
    MinWidth="740"
    MinHeight="480"
    Background="#FF1A1A1A"
    Foreground="#FFF"
    ResizeMode="CanResize"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="8"
            GlassFrameThickness="1"
            ResizeBorderThickness="4"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="DarkBg" Color="#FF1A1A1A" />
            <SolidColorBrush x:Key="SurfaceBg" Color="#FF0F0F0F" />
            <SolidColorBrush x:Key="BorderBrush" Color="#FF2A2A2A" />
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextSecondary" Color="#FFAAAAAA" />
            <SolidColorBrush x:Key="TextTertiary" Color="#FF666666" />
            <SolidColorBrush x:Key="DangerBrush" Color="#FFFF4444" />

            <CubicEase x:Key="ChillEase" EasingMode="EaseOut" />

            <Style x:Key="ModernBtn" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{StaticResource SurfaceBg}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="true">
                                <ContentPresenter
                                    x:Name="contentPresenter"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Focusable="False"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF252525" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF444444" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF151515" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="AccentBtn"
                BasedOn="{StaticResource ModernBtn}"
                TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{StaticResource TextPrimary}" />
                <Setter Property="Foreground" Value="{StaticResource DarkBg}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="DangerBtn"
                BasedOn="{StaticResource ModernBtn}"
                TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                <Setter Property="Background" Value="#11FF4444" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ChillTextBox" TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{StaticResource SurfaceBg}" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Height" Value="30" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
                <Setter Property="SelectionBrush" Value="{StaticResource TextSecondary}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                                <Grid>
                                    <ScrollViewer
                                        x:Name="PART_ContentHost"
                                        Focusable="false"
                                        HorizontalScrollBarVisibility="Hidden"
                                        VerticalScrollBarVisibility="Hidden" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                             <Storyboard>
                                                <ColorAnimation
                                                    EasingFunction="{StaticResource ChillEase}"
                                                    Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    To="#FFFFFFFF"
                                                    Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation
                                                    Storyboard.TargetName="border"
                                                    Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                    To="#FF2A2A2A"
                                                    Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#FF555555" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChillSwitch" TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type CheckBox}">
                            <Grid Margin="0,0,0,0" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    TextBlock.FontSize="12"
                                    TextBlock.FontWeight="Medium" />
                                <Border
                                    x:Name="Track"
                                    Grid.Column="1"
                                    Width="38"
                                    Height="20"
                                    Background="{StaticResource BorderBrush}"
                                    CornerRadius="10">
                                    <Grid>
                                        <Ellipse
                                            x:Name="Knob"
                                            Width="14"
                                            Height="14"
                                            Margin="3,0,0,0"
                                            HorizontalAlignment="Left"
                                            Fill="{StaticResource TextSecondary}">
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform X="0" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation
                                                    EasingFunction="{StaticResource ChillEase}"
                                                    Storyboard.TargetName="Track"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#FFFFFFFF"
                                                    Duration="0:0:0.3" />
                                                <ColorAnimation
                                                    Storyboard.TargetName="Knob"
                                                    Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                    To="#FF1A1A1A"
                                                    Duration="0:0:0.2" />
                                                <DoubleAnimation
                                                    EasingFunction="{StaticResource ChillEase}"
                                                    Storyboard.TargetName="Knob"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                    To="18"
                                                    Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation
                                                    Storyboard.TargetName="Track"
                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                    To="#FF2A2A2A"
                                                    Duration="0:0:0.3" />
                                                <ColorAnimation
                                                    Storyboard.TargetName="Knob"
                                                    Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                    To="#FFAAAAAA"
                                                    Duration="0:0:0.2" />
                                                <DoubleAnimation
                                                    EasingFunction="{StaticResource ChillEase}"
                                                    Storyboard.TargetName="Knob"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                    To="0"
                                                    Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavRadio" TargetType="{x:Type RadioButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Border
                                x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        x:Name="indicator"
                                        Width="3"
                                        Height="16"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource TextPrimary}"
                                        CornerRadius="1.5"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleY="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <ContentPresenter
                                        Grid.Column="1"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                    <Setter Property="Background" Value="#0FFFFFFF" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="indicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.2" />
                                                <DoubleAnimation
                                                    EasingFunction="{StaticResource ChillEase}"
                                                    Storyboard.TargetName="indicator"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                    To="1"
                                                    Duration="0:0:0.3" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="indicator"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.15" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="indicator"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                    To="0"
                                                    Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                    <Setter TargetName="border" Property="Background" Value="#08FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChillRadio" TargetType="{x:Type RadioButton}">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type RadioButton}">
                            <Grid Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    x:Name="Ring"
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource TextTertiary}"
                                    BorderThickness="1.5"
                                    CornerRadius="7">
                                    <Ellipse
                                        x:Name="Dot"
                                        Width="6"
                                        Height="6"
                                        Fill="{StaticResource TextPrimary}"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform ScaleX="0" ScaleY="0" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Border>
                                <ContentPresenter
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                    <Setter TargetName="Ring" Property="BorderBrush"
                                            Value="{StaticResource TextPrimary}" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Dot"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1"
                                                    Duration="0:0:0.15" />
                                                <DoubleAnimation
                                                    EasingFunction="{StaticResource ChillEase}"
                                                    Storyboard.TargetName="Dot"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                    To="1"
                                                    Duration="0:0:0.2" />
                                                <DoubleAnimation
                                                    EasingFunction="{StaticResource ChillEase}"
                                                    Storyboard.TargetName="Dot"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                    To="1"
                                                    Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Dot"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0"
                                                    Duration="0:0:0.15" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Dot"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                    To="0"
                                                    Duration="0:0:0.15" />
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Dot"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                    To="0"
                                                    Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                                    <Setter TargetName="Ring" Property="BorderBrush"
                                            Value="{StaticResource TextSecondary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FadeInPanel" TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="Visibility" Value="Visible">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="Opacity"
                                        From="0"
                                        To="1"
                                        Duration="0:0:0.3" />
                                    <DoubleAnimation
                                        EasingFunction="{StaticResource ChillEase}"
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                        From="6"
                                        To="0"
                                        Duration="0:0:0.3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DescriptionTxt" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextTertiary}" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SettingsScrollViewer" TargetType="{x:Type ScrollViewer}">
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ScrollContentPresenter Grid.Column="0" />
                                <ScrollBar
                                    x:Name="PART_VerticalScrollBar"
                                    Grid.Column="1"
                                    Margin="8,4,0,4"
                                    Maximum="{TemplateBinding ScrollableHeight}"
                                    Minimum="0"
                                    Orientation="Vertical"
                                    Value="{TemplateBinding VerticalOffset}"
                                    ViewportSize="{TemplateBinding ViewportHeight}"
                                    Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Window.RenderTransform>
        <TranslateTransform />
    </Window.RenderTransform>

    <Border
        Background="{StaticResource DarkBg}"
        BorderBrush="#FF444444"
        BorderThickness="1"
        CornerRadius="8"
        ClipToBounds="True">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{StaticResource SurfaceBg}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="18,14,18,14"
                    Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimary}"
                        Text="Settings" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="11"
                        Foreground="{StaticResource TextTertiary}"
                        Text="Preferences &amp; Config" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,0">
                    <RadioButton
                        x:Name="NavGeneral"
                        Checked="Nav_Checked"
                        Content="General"
                        GroupName="Nav"
                        IsChecked="True"
                        Style="{StaticResource NavRadio}" />
                    <RadioButton
                        x:Name="NavSystem"
                        Checked="Nav_Checked"
                        Content="System"
                        GroupName="Nav"
                        Style="{StaticResource NavRadio}" />
                    <RadioButton
                        x:Name="NavAdvanced"
                        Checked="Nav_Checked"
                        Content="Advanced"
                        GroupName="Nav"
                        Style="{StaticResource NavRadio}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="14,14">
                    <Button
                        Height="32"
                        Click="Ok_Click"
                        Content="Save Changes"
                        Style="{StaticResource AccentBtn}" />
                    <Button
                        Margin="0,6,0,0"
                        Click="Cancel_Click"
                        Content="Discard"
                        Style="{StaticResource ModernBtn}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource DarkBg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button
                    Width="32"
                    Height="26"
                    Margin="0,4,8,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="CloseButton_Click"
                    Cursor="Hand"
                    ToolTip="Close">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <Path
                                                Width="10"
                                                Height="10"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                                Fill="{StaticResource TextSecondary}"
                                                Stretch="Uniform" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                Margin="24,0,24,20"
                Focusable="False"
                Style="{StaticResource SettingsScrollViewer}">
                <ScrollViewer.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary
                                Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </ScrollViewer.Resources>
                <Grid>

                    <Grid
                        x:Name="ViewGeneral"
                        RenderTransformOrigin="0.5,0.5"
                        Style="{StaticResource FadeInPanel}"
                        Visibility="Visible">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,2"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimary}"
                                Text="General" />
                            <TextBlock
                                Margin="0,0,0,14"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondary}"
                                Text="Configure your installation paths." />

                            <Border
                                Padding="14,12"
                                Background="{StaticResource SurfaceBg}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource TextTertiary}"
                                            Text="INSTALLATION PATHS" />
                                        <Button
                                            HorizontalAlignment="Right"
                                            Click="AutoDetect_Click"
                                            Content="Auto-Detect"
                                            FontSize="11"
                                            Style="{StaticResource ModernBtn}" />
                                    </Grid>

                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock
                                            Margin="0,0,0,2"
                                            FontSize="12"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Steam Directory" />
                                        <TextBlock Style="{StaticResource DescriptionTxt}"
                                                   Text="The main installation folder containing Steam.exe." />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtSteamPath" Style="{StaticResource ChillTextBox}" />
                                            <Button
                                                Grid.Column="2"
                                                Width="70"
                                                Click="BrowseSteam_Click"
                                                Content="Browse"
                                                Style="{StaticResource ModernBtn}" />
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,2"
                                            FontSize="12"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="GreenLuma Directory" />
                                        <TextBlock Style="{StaticResource DescriptionTxt}"
                                                   Text="The folder where DLLInjector.exe and GreenLuma files are located." />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtGreenLumaPath" Style="{StaticResource ChillTextBox}" />
                                            <Button
                                                Grid.Column="2"
                                                Width="70"
                                                Click="BrowseGreenLuma_Click"
                                                Content="Browse"
                                                Style="{StaticResource ModernBtn}" />
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="0,10,0,0"
                                Padding="14,12"
                                Background="{StaticResource SurfaceBg}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextTertiary}"
                                        Text="API CONFIGURATION" />
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,2"
                                            FontSize="12"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Steam Web API Key" />
                                        <TextBlock Style="{StaticResource DescriptionTxt}">
                                            <Run Text="Required for extended search. Get one free at " />
                                            <Hyperlink
                                                Foreground="{StaticResource TextSecondary}"
                                                NavigateUri="https://steamcommunity.com/dev/apikey"
                                                RequestNavigate="Hyperlink_RequestNavigate"
                                                TextDecorations="Underline">
                                                steamcommunity.com/dev/apikey
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBox x:Name="TxtSteamApiKey" Style="{StaticResource ChillTextBox}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid
                        x:Name="ViewSystem"
                        RenderTransformOrigin="0.5,0.5"
                        Style="{StaticResource FadeInPanel}"
                        Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,2"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimary}"
                                Text="System" />
                            <TextBlock
                                Margin="0,0,0,14"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondary}"
                                Text="Manage application behavior and updates." />

                            <Border
                                Margin="0,0,0,10"
                                Padding="14,12"
                                Background="{StaticResource SurfaceBg}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,12"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextTertiary}"
                                        Text="STARTUP" />
                                    <StackPanel Margin="0,0,0,12">
                                        <CheckBox
                                            x:Name="ChkReplaceSteamAutostart"
                                            Content="Replace Steam on Windows Startup"
                                            Style="{StaticResource ChillSwitch}" />
                                        <TextBlock
                                            Margin="0,2,40,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextTertiary}"
                                            Text="Launch GreenLuma Manager automatically when Windows starts, replacing the default Steam startup."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12">
                                        <CheckBox
                                            x:Name="ChkPrefetchAppList"
                                            Content="Prefetch Steam App List"
                                            Style="{StaticResource ChillSwitch}" />
                                        <TextBlock
                                            Margin="0,2,40,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextTertiary}"
                                            Text="Prefetch the full Steam app list on startup without an API key. With an API key configured, this always happens automatically."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12">
                                        <CheckBox
                                            x:Name="ChkStartSteamMinimized"
                                            Content="Start Steam Minimized"
                                            Style="{StaticResource ChillSwitch}" />
                                        <TextBlock
                                            Margin="0,2,40,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextTertiary}"
                                            Text="Launch Steam minimized to the system tray instead of showing the main window."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,12">
                                        <CheckBox
                                            x:Name="ChkDisableGreenLumaVersionNotice"
                                            Content="Disable GreenLuma Version Notice"
                                            Style="{StaticResource ChillSwitch}" />
                                        <TextBlock
                                            Margin="0,2,40,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextTertiary}"
                                            Text="Hide the detected GreenLuma version and outdated warning from the status bar."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel>
                                        <CheckBox
                                            x:Name="ChkCheckGreenLumaUpdates"
                                            Content="Check GreenLuma Forum for Updates"
                                            Style="{StaticResource ChillSwitch}" />
                                        <TextBlock
                                            Margin="0,2,40,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextTertiary}"
                                            Text="Check the GreenLuma forum thread on startup for a newer release than what's installed. Opens a hidden browser instance to read the page. The first time this can be determined, it turns itself on or off automatically based on whether the forum is reachable, then stays as you set it here."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="14,12"
                                Background="{StaticResource SurfaceBg}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,12"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource TextTertiary}"
                                        Text="UPDATES" />
                                    <StackPanel Margin="0,0,0,12">
                                        <CheckBox
                                            x:Name="ChkDisableUpdateCheck"
                                            Checked="DisableUpdateCheck_Changed"
                                            Content="Disable Update Checking"
                                            Style="{StaticResource ChillSwitch}"
                                            Unchecked="DisableUpdateCheck_Changed" />
                                        <TextBlock
                                            Margin="0,2,40,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextTertiary}"
                                            Text="Prevent the application from checking for new versions on startup."
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel>
                                        <CheckBox
                                            x:Name="ChkAutoUpdate"
                                            Content="Auto-Install Updates"
                                            Style="{StaticResource ChillSwitch}" />
                                        <TextBlock
                                            Margin="0,2,40,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextTertiary}"
                                            Text="Download and install updates automatically instead of being redirected to the GitHub page."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid
                        x:Name="ViewAdvanced"
                        RenderTransformOrigin="0.5,0.5"
                        Style="{StaticResource FadeInPanel}"
                        Visibility="Collapsed">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>

                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,2"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimary}"
                                Text="Advanced" />
                            <TextBlock
                                Margin="0,0,0,14"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondary}"
                                Text="Dangerous actions and data management." />

                            <Border
                                Margin="0,0,0,10"
                                Padding="14,12"
                                Background="{StaticResource SurfaceBg}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimary}"
                                            Text="App Data Folder" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Open the folder where GreenLuma Manager stores its configuration and profiles."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Click="OpenAppData_Click"
                                        Content="Open"
                                        Style="{StaticResource ModernBtn}" />
                                </Grid>
                            </Border>

                            <Border
                                Margin="0,0,0,10"
                                Padding="14,12"
                                Background="{StaticResource SurfaceBg}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimary}"
                                            Text="Restart Steam" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Kill all Steam processes and relaunch Steam."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Click="RestartSteam_Click"
                                        Content="Restart"
                                        Style="{StaticResource ModernBtn}" />
                                </Grid>
                            </Border>

                            <Border
                                Margin="0,0,0,10"
                                Padding="14,12"
                                Background="{StaticResource SurfaceBg}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimary}"
                                            Text="GreenLuma Version" />
                                        <TextBlock
                                            x:Name="TxtGreenLumaVersionOverride"
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Change which GreenLuma version's behavior is used for AppList generation."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        x:Name="BtnChangeGreenLumaVersion"
                                        Grid.Column="1"
                                        Click="ChangeGreenLumaVersion_Click"
                                        Content="Change"
                                        Style="{StaticResource ModernBtn}" />
                                </Grid>
                            </Border>

                            <Border
                                Margin="0,0,0,10"
                                Padding="14,12"
                                Background="{StaticResource SurfaceBg}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimary}"
                                        Text="Install / Update GreenLuma" />
                                    <TextBlock Style="{StaticResource DescriptionTxt}"
                                               Text="Extract a GreenLuma zip file and deploy it to the GreenLuma Directory set on the General tab. Works for a fresh install or updating an existing one." />

                                    <Grid Margin="0,8,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox
                                            x:Name="TxtGreenLumaZipPath"
                                            IsReadOnly="True"
                                            Style="{StaticResource ChillTextBox}" />
                                        <Button
                                            Grid.Column="2"
                                            Width="70"
                                            Click="BrowseGreenLumaZip_Click"
                                            Content="Browse"
                                            Style="{StaticResource ModernBtn}" />
                                    </Grid>

                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <RadioButton
                                            x:Name="RbDeployNormal"
                                            Margin="0,0,16,0"
                                            Content="Normal"
                                            GroupName="DeployMode"
                                            IsChecked="True"
                                            Style="{StaticResource ChillRadio}" />
                                        <RadioButton
                                            x:Name="RbDeployStealth"
                                            Content="Stealth"
                                            GroupName="DeployMode"
                                            Style="{StaticResource ChillRadio}" />
                                    </StackPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="TxtDeployStatus"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondary}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Name="BtnDeployGreenLuma"
                                            Grid.Column="2"
                                            Click="DeployGreenLuma_Click"
                                            Content="Install / Update"
                                            IsEnabled="False"
                                            Style="{StaticResource ModernBtn}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Padding="14,12"
                                Background="#0DFF4444"
                                BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DangerBrush}"
                                            Text="Danger Zone" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondary}"
                                            Text="Irreversibly wipe all application data, profiles, settings, and cache."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Click="WipeData_Click"
                                        Content="Wipe Data"
                                        Style="{StaticResource DangerBtn}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                </Grid>
            </ScrollViewer>
        </Grid>
        </Grid>
    </Border>
</Window>